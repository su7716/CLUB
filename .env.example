# 개발 중에는 비워 두면 로컬 파일(.data/db.json)을 DB로 사용합니다.
# Vercel Marketplace(Neon Postgres)를 쓰려면 연결 문자열을 채웁니다.
DATABASE_URL=

# 세션 쿠키 서명용 (32자 이상 임의 문자열)
SESSION_SECRET=change-me-to-a-long-random-string-0000
# 관리자 2차 비밀번호
ADMIN_PASSCODE=change-me
# 회원 초대코드 초기값 (이후 관리자 화면에서 변경)
INVITE_CODE=123456

# AI 기능 단계에서 사용
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
